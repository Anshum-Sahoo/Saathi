# Public Firebase Web app settings (Firebase Authentication only; never Firestore).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin server credentials. Local development may use Application Default Credentials.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Independent high-entropy server secrets.
ELDER_PIN_PEPPER=
PAIRING_CODE_PEPPER=

# Exact public origin used by state-changing API routes.
APP_BASE_URL=
